<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.PaymentRecordMapper">

    <resultMap id="BaseResultMap" type="com.campus.trade.model.entity.PaymentRecord">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="trade_no" property="tradeNo"/>
        <result column="amount" property="amount"/>
        <result column="status" property="status"/>
        <result column="pay_channel" property="payChannel"/>
        <result column="callback_raw" property="callbackRaw"/>
        <result column="callback_time" property="callbackTime"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByTradeNo" resultMap="BaseResultMap">
        SELECT * FROM t_payment_record WHERE trade_no = #{tradeNo}
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM t_payment_record WHERE order_no = #{orderNo} ORDER BY created_at DESC LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_payment_record (order_no, trade_no, amount, status, pay_channel, callback_raw, callback_time)
        VALUES (#{orderNo}, #{tradeNo}, #{amount}, #{status}, #{payChannel}, #{callbackRaw}, #{callbackTime})
    </insert>

    <update id="updateStatus">
        UPDATE t_payment_record SET status = #{status} WHERE trade_no = #{tradeNo}
    </update>
</mapper>
