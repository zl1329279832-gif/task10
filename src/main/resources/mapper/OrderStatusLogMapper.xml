<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.OrderStatusLogMapper">
    <resultMap id="BaseResult" type="com.campus.trade.domain.entity.OrderStatusLog">
        <id column="id" property="id"/><result column="order_id" property="orderId"/><result column="from_status" property="fromStatus"/>
        <result column="to_status" property="toStatus"/><result column="operator_id" property="operatorId"/><result column="remark" property="remark"/><result column="created_at" property="createdAt"/>
    </resultMap>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO t_order_status_log (order_id,from_status,to_status,operator_id,remark) VALUES (#{orderId},#{fromStatus},#{toStatus},#{operatorId},#{remark})</insert>
    <select id="findByOrderId" resultMap="BaseResult">SELECT * FROM t_order_status_log WHERE order_id=#{orderId} ORDER BY created_at ASC</select>
    <select id="findLatestByOrderId" resultMap="BaseResult">SELECT * FROM t_order_status_log WHERE order_id=#{orderId} ORDER BY created_at DESC LIMIT 1</select>
</mapper>
