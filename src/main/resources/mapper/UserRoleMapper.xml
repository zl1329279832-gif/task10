<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.UserRoleMapper">
    <select id="findRoleCodesByUserId" resultType="string">SELECT r.role_code FROM t_user_role ur INNER JOIN t_role r ON ur.role_id=r.id WHERE ur.user_id=#{userId}</select>
    <insert id="insert">INSERT INTO t_user_role (user_id,role_id) VALUES (#{userId},#{roleId})</insert>
    <delete id="deleteByUserId">DELETE FROM t_user_role WHERE user_id=#{userId}</delete>
</mapper>
