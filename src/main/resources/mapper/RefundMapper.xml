<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.RefundMapper">
    <resultMap id="BaseResult" type="com.campus.trade.domain.entity.Refund">
        <id column="id" property="id"/><result column="refund_no" property="refundNo"/><result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/><result column="buyer_id" property="buyerId"/><result column="seller_id" property="sellerId"/>
        <result column="refund_amount" property="refundAmount"/><result column="reason" property="reason"/><result column="status" property="status"/>
        <result column="evidence_urls" property="evidenceUrls"/><result column="reject_reason" property="rejectReason"/>
        <result column="approved_by" property="approvedBy"/><result column="approved_at" property="approvedAt"/>
        <result column="refund_trade_no" property="refundTradeNo"/><result column="created_at" property="createdAt"/><result column="updated_at" property="updatedAt"/>
    </resultMap>
    <select id="findById" resultMap="BaseResult">SELECT * FROM t_refund WHERE id=#{id}</select>
    <select id="findByRefundNo" resultMap="BaseResult">SELECT * FROM t_refund WHERE refund_no=#{refundNo}</select>
    <select id="findByOrderId" resultMap="BaseResult">SELECT * FROM t_refund WHERE order_id=#{orderId} ORDER BY created_at DESC LIMIT 1</select>
    <select id="findBySellerId" resultMap="BaseResult">SELECT * FROM t_refund WHERE seller_id=#{sellerId} <if test="status!=null and status!=''"> AND status=#{status}</if> ORDER BY created_at DESC LIMIT #{offset},#{limit}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO t_refund (refund_no,order_id,order_no,buyer_id,seller_id,refund_amount,reason,status,evidence_urls) VALUES (#{refundNo},#{orderId},#{orderNo},#{buyerId},#{sellerId},#{refundAmount},#{reason},#{status},#{evidenceUrls})</insert>
    <update id="updateStatus">UPDATE t_refund SET status=#{toStatus}, updated_at=NOW() WHERE id=#{id} AND status=#{fromStatus}</update>
    <update id="updateApproval">UPDATE t_refund SET approved_by=#{approvedBy}, approved_at=#{approvedAt}, reject_reason=#{rejectReason}, updated_at=NOW() WHERE id=#{id}</update>
    <update id="updateRefundTradeNo">UPDATE t_refund SET refund_trade_no=#{tradeNo}, updated_at=NOW() WHERE id=#{id}</update>
</mapper>
