<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.DisputeMapper">

    <resultMap id="BaseResultMap" type="com.campus.trade.model.entity.Dispute">
        <id column="id" property="id"/>
        <result column="dispute_no" property="disputeNo"/>
        <result column="order_no" property="orderNo"/>
        <result column="refund_no" property="refundNo"/>
        <result column="initiator_id" property="initiatorId"/>
        <result column="reason" property="reason"/>
        <result column="buyer_evidence" property="buyerEvidence"/>
        <result column="seller_evidence" property="sellerEvidence"/>
        <result column="status" property="status"/>
        <result column="arbitrator_id" property="arbitratorId"/>
        <result column="arbitrate_result" property="arbitrateResult"/>
        <result column="arbitrate_remark" property="arbitrateRemark"/>
        <result column="arbitrated_at" property="arbitratedAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByDisputeNo" resultMap="BaseResultMap">
        SELECT * FROM t_dispute WHERE dispute_no = #{disputeNo}
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM t_dispute WHERE order_no = #{orderNo} ORDER BY created_at DESC LIMIT 1
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM t_dispute
        <where>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY created_at DESC LIMIT #{offset}, #{limit}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM t_dispute
        <where>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dispute (dispute_no, order_no, refund_no, initiator_id, reason, buyer_evidence, status)
        VALUES (#{disputeNo}, #{orderNo}, #{refundNo}, #{initiatorId}, #{reason}, #{buyerEvidence}, #{status})
    </insert>

    <update id="updateEvidence">
        UPDATE t_dispute
        <set>
            <if test="buyerEvidence != null">buyer_evidence = #{buyerEvidence},</if>
            <if test="sellerEvidence != null">seller_evidence = #{sellerEvidence},</if>
        </set>
        WHERE dispute_no = #{disputeNo}
    </update>

    <update id="updateArbitrate">
        UPDATE t_dispute SET status = #{status}, arbitrator_id = #{arbitratorId},
               arbitrate_result = #{arbitrateResult}, arbitrate_remark = #{arbitrateRemark}, arbitrated_at = NOW()
        WHERE dispute_no = #{disputeNo}
    </update>
</mapper>
