<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.RefundRecordMapper">

    <resultMap id="BaseResultMap" type="com.campus.trade.model.entity.RefundRecord">
        <id column="id" property="id"/>
        <result column="refund_no" property="refundNo"/>
        <result column="order_no" property="orderNo"/>
        <result column="buyer_id" property="buyerId"/>
        <result column="seller_id" property="sellerId"/>
        <result column="amount" property="amount"/>
        <result column="reason" property="reason"/>
        <result column="evidence_urls" property="evidenceUrls"/>
        <result column="status" property="status"/>
        <result column="handler_id" property="handlerId"/>
        <result column="handle_remark" property="handleRemark"/>
        <result column="handled_at" property="handledAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByRefundNo" resultMap="BaseResultMap">
        SELECT * FROM t_refund_record WHERE refund_no = #{refundNo}
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM t_refund_record WHERE order_no = #{orderNo} ORDER BY created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_refund_record (refund_no, order_no, buyer_id, seller_id, amount, reason, evidence_urls, status)
        VALUES (#{refundNo}, #{orderNo}, #{buyerId}, #{sellerId}, #{amount}, #{reason}, #{evidenceUrls}, #{status})
    </insert>

    <update id="updateHandle">
        UPDATE t_refund_record SET status = #{status}, handler_id = #{handlerId},
               handle_remark = #{handleRemark}, handled_at = NOW()
        WHERE refund_no = #{refundNo}
    </update>
</mapper>
