<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.ProductMapper">
    <resultMap id="BaseResult" type="com.campus.trade.domain.entity.Product">
        <id column="id" property="id"/><result column="seller_id" property="sellerId"/><result column="title" property="title"/>
        <result column="description" property="description"/><result column="category" property="category"/><result column="images" property="images"/>
        <result column="status" property="status"/><result column="created_at" property="createdAt"/><result column="updated_at" property="updatedAt"/>
    </resultMap>
    <select id="findById" resultMap="BaseResult">SELECT * FROM t_product WHERE id=#{id}</select>
    <select id="findBySellerId" resultMap="BaseResult">SELECT * FROM t_product WHERE seller_id=#{sellerId} <if test="status!=null"> AND status=#{status}</if> ORDER BY created_at DESC</select>
    <select id="findAll" resultMap="BaseResult">SELECT * FROM t_product <where><if test="status!=null"> AND status=#{status}</if><if test="keyword!=null and keyword!=''"> AND (title LIKE CONCAT('%',#{keyword},'%') OR description LIKE CONCAT('%',#{keyword},'%'))</if></where> ORDER BY created_at DESC LIMIT #{offset},#{limit}</select>
    <select id="count" resultType="long">SELECT COUNT(*) FROM t_product <where><if test="status!=null"> AND status=#{status}</if><if test="keyword!=null and keyword!=''"> AND (title LIKE CONCAT('%',#{keyword},'%') OR description LIKE CONCAT('%',#{keyword},'%'))</if></where></select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO t_product (seller_id,title,description,category,images,status) VALUES (#{sellerId},#{title},#{description},#{category},#{images},#{status})</insert>
    <update id="updateStatus">UPDATE t_product SET status=#{status} WHERE id=#{id}</update>
</mapper>
