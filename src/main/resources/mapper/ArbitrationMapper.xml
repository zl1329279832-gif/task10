<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.mapper.ArbitrationMapper">
    <resultMap id="BaseResult" type="com.campus.trade.domain.entity.Arbitration">
        <id column="id" property="id"/><result column="arbitration_no" property="arbitrationNo"/><result column="dispute_id" property="disputeId"/>
        <result column="order_id" property="orderId"/><result column="arbiter_id" property="arbiterId"/><result column="result" property="result"/>
        <result column="decision" property="decision"/><result column="refund_amount" property="refundAmount"/><result column="created_at" property="createdAt"/>
    </resultMap>
    <select id="findById" resultMap="BaseResult">SELECT * FROM t_arbitration WHERE id=#{id}</select>
    <select id="findByDisputeId" resultMap="BaseResult">SELECT * FROM t_arbitration WHERE dispute_id=#{disputeId} LIMIT 1</select>
    <select id="findByArbitrationNo" resultMap="BaseResult">SELECT * FROM t_arbitration WHERE arbitration_no=#{arbitrationNo}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO t_arbitration (arbitration_no,dispute_id,order_id,arbiter_id,result,decision,refund_amount) VALUES (#{arbitrationNo},#{disputeId},#{orderId},#{arbiterId},#{result},#{decision},#{refundAmount})</insert>
</mapper>
